{
  "name": "verdean",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",

    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/verdean-domain.test.ts tests/verdean-organization.test.ts tests/verdean-reviewer-email.test.ts tests/verdean-workspace-access.test.ts tests/verdean-workspace-persistence.test.ts tests/verdean-workspace-route-contract.test.mjs tests/verdean-demo-kit.test.mjs tests/verdean-migration.test.mjs tests/verdean-ui-integration.test.mjs tests/document-intelligence-client.test.ts tests/document-intelligence-route.test.ts tests/document-intelligence.test.ts tests/local-folder-watching.test.mjs",
    "demo:prepare": "node scripts/prepare-demo-kit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ai:proxy": "hermes proxy start --provider nous --host 127.0.0.1 --port 8645"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "openskill": "5.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260820.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
