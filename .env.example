# Local document intelligence defaults. These values work with `npm run
# ai:proxy` after Hermes has been installed and authenticated with `hermes
# portal`. The proxy accepts any placeholder bearer token and injects the
# collaborator's own OAuth credentials server-side.
DOCUMENT_AI_BASE_URL=http://127.0.0.1:8645/v1
DOCUMENT_AI_API_KEY=sk-unused
DOCUMENT_AI_MODEL=google/gemini-3.7-flash
DOCUMENT_AI_PROVIDER=Hermes subscription proxy

# To use another OpenAI-compatible vision provider, replace the four values
# above in .env.local. Never commit a real API key.

# Optional deployment metadata. Leave these at their local defaults for
# development; set them only in an ignored local environment file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERDEAN_D1_BINDING=DB
